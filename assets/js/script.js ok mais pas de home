document.addEventListener("DOMContentLoaded", () => {
  const brandPanel = document.querySelector(".brand-panel");
  const currentPath = window.location.pathname.split("/").pop() || "index.html";

  // Force le bon état du panneau selon la page d'arrivée au chargement initial
  const isHomePage = currentPath === "index.html" || currentPath === "" || currentPath === "./";

  if (brandPanel) {
    if (isHomePage) {
      brandPanel.classList.remove("side");
      brandPanel.classList.add("full");
    } else {
      brandPanel.classList.remove("full");
      brandPanel.classList.add("side");
    }
  }

  // 1. Injection dynamique du bouton Hamburger dans le DOM
  const menuBtn = document.createElement("button");
  menuBtn.className = "mobile-menu-btn";
  menuBtn.setAttribute("aria-label", "Ouvrir le menu");
  menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';
  document.body.appendChild(menuBtn);

  // Mise à jour initiale de l'état mobile
  updateMobileMenuState();

  // 2. Gestion de l'ouverture / fermeture du menu mobile
  menuBtn.addEventListener("click", () => {
    const isOpen = brandPanel.classList.toggle("mobile-open");
    menuBtn.innerHTML = isOpen
      ? '<i class="fa-solid fa-xmark"></i>'
      : '<i class="fa-solid fa-bars"></i>';
  });

  // 3. Délégation d'événements globale sur le document
  document.body.addEventListener("click", (e) => {
    // A. Gestion du sous-menu accordéon (Portfolio)
    const toggleBtn = e.target.closest(".submenu-toggle");
    if (toggleBtn) {
      e.preventDefault();
      e.stopPropagation();
      const parentItem = toggleBtn.closest(".has-submenu");
      if (parentItem) {
        parentItem.classList.toggle("open");
      }
      return;
    }

    // B. Interception dynamique des clics sur les liens <a>
    const link = e.target.closest("a");
    if (!link) return;

    const targetUrl = link.getAttribute("href");

    // Traiter uniquement les liens internes locaux
    if (targetUrl && !targetUrl.startsWith("#") && !targetUrl.startsWith("http") && !targetUrl.startsWith("javascript:")) {
      e.preventDefault();

      // Si on clique sur la page actuellement ouverte
      if (window.location.pathname.endsWith(targetUrl)) {
        closeMobileMenu();
        return;
      }

      loadPage(targetUrl);
    }
  });

  function closeMobileMenu() {
    if (brandPanel) {
      brandPanel.classList.remove("mobile-open");
    }
    menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';
  }

  function updateMobileMenuState() {
    if (!brandPanel) return;
    // Si la bannière est en mode "side", on affiche le bouton hamburger sur mobile
    if (brandPanel.classList.contains("side")) {
      document.body.classList.add("has-mobile-menu");
    } else {
      document.body.classList.remove("has-mobile-menu");
      closeMobileMenu();
    }
  }

  // 4. Fonction de chargement dynamique AJAX
  async function loadPage(url) {
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error(`Erreur HTTP: ${response.status}`);

      const htmlText = await response.text();
      const parser = new DOMParser();
      const newDoc = parser.parseFromString(htmlText, "text/html");

      const newMainContent = newDoc.querySelector(".main-content");
      let currentMainContent = document.querySelector(".main-content");

      // Animation de sortie du contenu principal actuel
      if (currentMainContent) {
        currentMainContent.classList.add("fade-out");
      }

      closeMobileMenu();

      // Vérification : Seule la vraie page d'accueil principale doit rester en plein écran ("full")
      const isHomePage =
        url === "index.html" ||
        url === "./" ||
        url === "/" ||
        (url.endsWith("index.html") && !url.includes("portfolio"));

      if (isHomePage) {
        brandPanel.classList.remove("side");
        brandPanel.classList.add("full");
      } else {
        brandPanel.classList.remove("full");
        brandPanel.classList.add("side");
      }

      updateMobileMenuState();

      // Mise à jour du contenu après la transition
      setTimeout(() => {
        document.title = newDoc.title;

        if (newMainContent) {
          if (!currentMainContent) {
            currentMainContent = document.createElement("main");
            currentMainContent.className = "main-content fade-out";
            document.body.appendChild(currentMainContent);
          }
          currentMainContent.innerHTML = newMainContent.innerHTML;

          requestAnimationFrame(() => {
            currentMainContent.classList.remove("fade-out");
          });
        } else if (currentMainContent) {
          currentMainContent.remove();
        }

        history.pushState({}, "", url);
      }, 400);

    } catch (err) {
      console.warn("Fallback redirection classique :", err);
      window.location.href = url;
    }
  }

  // 5. Gestion des boutons Précédent / Suivant du navigateur
  window.addEventListener("popstate", () => {
    const path = window.location.pathname.split("/").pop() || "index.html";
    loadPage(path);
  });
});